{
  "cleanUrls": true,
  "functions": { "api/product-page.mjs": { "includeFiles": "dist/index.html" } },
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] }
  ],
  "rewrites": [
    { "source": "/deal/:asin", "destination": "/api/product-page?asin=:asin" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
